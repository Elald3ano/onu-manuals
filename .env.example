# Copia este archivo a .env y completa los valores de tu proyecto.
# Panel de Supabase -> Project Settings -> API.

VITE_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# ⚠️ Nunca incluyas la service_role key en una variable VITE_.
# Se incrustaría en el bundle del navegador y permitiría saltarse RLS.

# -----------------------------------------------------------------------------
# Solo para `npm run seed:supabase` (se ejecuta en tu máquina, no en el navegador).
# Usa UNA de estas dos opciones:
# -----------------------------------------------------------------------------

# Opción A (recomendada): cuenta administradora creada en Authentication.
# SUPABASE_ADMIN_EMAIL=admin@tu-dominio.com
# SUPABASE_ADMIN_PASSWORD=tu-password

# Opción B: service_role key, únicamente en local. Nunca la subas al repo.
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
